{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"],
  /* Tests run under `bun test`, which supplies `bun:test` / `bun:sqlite` at
     runtime. They are not emitted to dist, so the build does not typecheck them. */
  "exclude": ["node_modules", "dist", "src/**/*.test.ts", "tests"]
}
